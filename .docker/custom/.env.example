# AFFiNE Custom Build - Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================
# Server Configuration
# ============================================
PORT=3010
AFFINE_SERVER_HOST=localhost
AFFINE_SERVER_HTTPS=false

# Alternative: Use AFFINE_SERVER_EXTERNAL_URL for full URL
# AFFINE_SERVER_EXTERNAL_URL=https://affine.yourdomain.com

# ============================================
# Data Persistence Locations
# ============================================
# IMPORTANT: Use absolute paths for production deployments
# Example: /home/youruser/affine-data/postgres
DB_DATA_LOCATION=./pgdata
UPLOAD_LOCATION=./storage
CONFIG_LOCATION=./config

# ============================================
# Database Credentials
# ============================================
DB_USERNAME=affine
# IMPORTANT: Change this password for production!
DB_PASSWORD=affine
DB_DATABASE=affine

# ============================================
# Optional: Admin User Configuration
# ============================================
# The first user to register will become admin
# Or you can pre-configure admin credentials here
# AFFINE_ADMIN_EMAIL=admin@example.com
# AFFINE_ADMIN_PASSWORD=your_secure_password

# ============================================
# Custom Build Info
# ============================================
# This deployment uses a custom AFFiNE build with:
# - 10GB frontend file upload limit
# - 1GB backend file upload limit
# - 5-minute upload timeout
# - 999 member limit per workspace
# - 10TB storage quota
# - 1-year history retention
# - Removed UI prompts
#
# FOR PERSONAL USE ONLY - NOT FOR COMMERCIAL DEPLOYMENT
